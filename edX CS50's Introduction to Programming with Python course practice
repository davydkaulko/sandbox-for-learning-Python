        print ("lunch time")
    elif  18 <= convert(text) <= 19 :
        print ("dinner time")
    else :
        print ("It’s not time for a meal")
    return
def convert(text): #pm or am тут бля буду проверять есть ли там буква и если есть то ам дает ноль к часам а пм дает +12ч
    clear = text.strip()
    dividedtext = clear.split(":")
    a = int(dividedtext[0])
    b = int(dividedtext[1])
    hours = (float(a))
    minutes = (float(b / 60))
    sumhoursminutes = hours + minutes
    return sumhoursminutes
    
