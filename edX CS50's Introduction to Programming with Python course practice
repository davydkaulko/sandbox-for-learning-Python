    # convert string time → float hours (e.g. "7:30" → 7.5)
    convertedtext = convert(text) 

    # check meal time ranges (inclusive)
    if 7 <= convertedtext <= 8: 
        print("breakfast time")
    elif 12 <= convertedtext <= 13:
        print("lunch time")
    elif 18 <= convertedtext <= 19:
        print("dinner time")
    else:
        # not required by task, but useful for debugging
        print("It’s not time for a meal")

    return


def convert(text):
    # remove extra spaces
    clear = text.strip()

    # split time into hours and minutes → ["7", "30"]
    dividedtext = clear.split(":")

    # convert both parts to integers
    a = int(dividedtext[0])  # hours
    b = int(dividedtext[1])  # minutes

    # convert to float format
    hours = float(a)
    minutes = float(b / 60)

    # combine into one float value (e.g. 7.5)
    sumhoursminutes = hours + minutes

    return sumhoursminutes


