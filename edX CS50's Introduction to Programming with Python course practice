def is_valid(plate):
    if not plate[0:2].isalpha():
       return False  
    if not (2 <= len(plate) <= 6):
         return False    
    found_digit = False
    for char in plate:
        if char.isdigit():
            if not found_digit:
                if char == "0":
                    return False
                found_digit = True
        else:
            if found_digit:
                return False
        
    if not plate.isalnum():
         return False  
    return True 
